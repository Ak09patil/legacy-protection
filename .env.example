# Copy this file to .env and fill in your own values. .env is never committed.
# Sandbox only: the code refuses to talk to live PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI (set a spending limit on the key first)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Database (Postgres 16). Migrations run as the owner; the app connects as the least-privilege lp_app role.
DATABASE_OWNER_URL=postgresql://localhost:5432/legacy_protection
LP_APP_PASSWORD=change-me
