# Copy this file to .env and fill in your own values. .env is never committed.
# Sandbox only: the code refuses to talk to live PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Your sandbox Personal account's email (Testing Tools → Sandbox Accounts). Plays Maria, the carer.
PAYPAL_SANDBOX_MARIA_EMAIL=

# AI (set a spending limit on the key first)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Database (Postgres 16). Migrations run as the owner; the app connects as the least-privilege lp_app role.
DATABASE_OWNER_URL=postgresql://localhost:5432/legacy_protection
LP_APP_PASSWORD=change-me

# The Temporal worker (pnpm worker) connects as the app role, like the web app.
DATABASE_URL=postgresql://lp_app:change-me@localhost:5432/legacy_protection
# Local: run `temporal server start-dev` (brew install temporal). Temporal Cloud: set TEMPORAL_API_KEY and TEMPORAL_NAMESPACE too.
TEMPORAL_ADDRESS=localhost:7233

# The vault (pnpm vault): its own database and its own secrets. Generate each with: openssl rand -hex 32
VAULT_DATABASE_URL=postgresql://localhost:5432/legacy_protection_vault
VAULT_MASTER_KEY=
VAULT_SECRET_WEB=
VAULT_SECRET_WORKER=
VAULT_URL=http://127.0.0.1:8787
