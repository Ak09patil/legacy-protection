{
  "name": "legacy-protection",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/policy packages/guard packages/paypal packages/db packages/ai workers/executor",
    "dev": "pnpm --filter @lp/web dev",
    "check:paypal": "node --env-file=.env scripts/check-paypal.mjs",
    "db:migrate": "tsx --env-file=.env packages/db/scripts/migrate.mts",
    "paypal:smoke": "tsx --env-file=.env --tsconfig tsconfig.scripts.json packages/paypal/scripts/smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
